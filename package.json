{
  "name": "@reverserid/signal-client",
  "version": "0.1.0",
  "description": "Reverse-engineered TypeScript client for the Bombasignal / app.signal.id mobile API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "verify": "tsx scripts/verify.ts",
    "example": "tsx examples/init.ts",
    "login": "tsx examples/login.ts",
    "cekpajak": "tsx examples/cekpajak.ts",
    "cekranmor": "tsx examples/cekranmor.ts",
    "submissionCektax": "tsx examples/cektax.ts",
    "epengesahan": "tsx examples/epengesahan.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": { "node": ">=18.17" },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
